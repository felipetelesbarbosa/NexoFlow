# syntax=docker/dockerfile:1
FROM python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/central:/opt/shared
WORKDIR /opt/central
COPY hub/requirements.lock hub/central-requirements.lock ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    python -m pip --disable-pip-version-check install --no-cache-dir -r requirements.lock -r central-requirements.lock
COPY --chown=10001:10001 hub/nexoflow_hub/__init__.py hub/nexoflow_hub/central.py hub/nexoflow_hub/infrastructure.py hub/nexoflow_hub/api_observability.py ./nexoflow_hub/
COPY --chown=10001:10001 hub/nexoflow_hub/api.py hub/nexoflow_hub/config.py hub/nexoflow_hub/contracts.py hub/nexoflow_hub/store.py hub/nexoflow_hub/weni_events.py ./nexoflow_hub/
COPY --chown=10001:10001 app/order_history.py app/pedido_utils.py app/business_identity.py /opt/shared/
RUN install -d -m 0700 -o 10001 -g 10001 /var/lib/nexoflow-central
USER 10001:10001
CMD ["python", "-m", "uvicorn", "nexoflow_hub.central:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--no-server-header"]
