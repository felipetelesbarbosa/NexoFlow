      "parameters": {
        "jsCode": "const primeiro = $('Enviar evento sintético').first().json;\nconst segundo = $input.first().json;\nif (primeiro.estado !== 'CONFIRMADO' || segundo.estado !== 'CONFIRMADO' || !primeiro.recibo || primeiro.recibo !== segundo.recibo || !primeiro.recebido_em || primeiro.recebido_em !== segundo.recebido_em) {\n  throw new Error('RECIBO_INCONSISTENTE');\n}\nreturn [{ json: { estado: 'CONFIRMADO', recibo: segundo.recibo, recebido_em: segundo.recebido_em } }];"
      }
    }
