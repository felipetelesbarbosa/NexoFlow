                },
                "conditions": [
                  {
                    "id": "atualizacao_weni_bloqueado",
                    "leftValue": "={{ ['falhou', 'revisao_necessaria'].includes($json.estado) }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Bloqueada"
            },
