                  "version": 2
                },
                "conditions": [
                  {
                    "id": "atualizacao_weni_confirmado",
                    "leftValue": "={{ $json.etapas.some(etapa => etapa.etapa === 'atualizacao_weni' && etapa.estado === 'concluida') }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
