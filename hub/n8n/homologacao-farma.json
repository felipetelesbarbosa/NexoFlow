{
  "name": "Hub — Homologação FARMA",
  "active": false,
  "nodes": [
    {
      "id": "manual",
      "name": "Iniciar homologação",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "create",
      "name": "Criar tarefa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://hub-api:8000/tarefas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"segmento\": \"FARMA\", \"origem\": \"n8n\", \"chave\": \"manual-hml-01\", \"cenario\": \"normal\"}",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR_FARMA",
          "name": "Hub HML FARMA"
        }
      }
    },
    {
      "id": "wait",
      "name": "Aguardar",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      }
    },
    {
      "id": "status",
      "name": "Consultar estado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "url": "=http://hub-api:8000/tarefas/{{ $('Criar tarefa').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR_FARMA",
          "name": "Hub HML FARMA"
        }
      }
    },
    {
      "id": "if",
      "name": "Terminou",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "terminal",
              "leftValue": "={{ ['concluida','parcial','falhou','revisao_necessaria'].includes($json.estado) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "result",
      "name": "Consultar resultado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "url": "=http://hub-api:8000/tarefas/{{ $('Criar tarefa').item.json.id }}/resultado",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR_FARMA",
          "name": "Hub HML FARMA"
        }
      }
    }
  ],
  "connections": {
    "Iniciar homologação": {
      "main": [
        [
          {
            "node": "Criar tarefa",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Criar tarefa": {
      "main": [
        [
          {
            "node": "Aguardar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aguardar": {
      "main": [
        [
          {
            "node": "Consultar estado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar estado": {
      "main": [
        [
          {
            "node": "Terminou",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Terminou": {
      "main": [
        [
          {
            "node": "Consultar resultado",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Aguardar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 120,
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none"
  }
}
