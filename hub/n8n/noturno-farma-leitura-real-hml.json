{
  "name": "NexoFlow Hub — Noturno FARMA (leitura real amostral)",
  "active": false,
  "nodes": [
    {
      "id": "manual",
      "name": "Iniciar diagnóstico manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "create",
      "name": "Enfileirar Noturno FARMA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "http://hub-api:8000/tarefas/noturno",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { segmento: 'FARMA', origem: 'n8n', chave: 'noturno-leitura-real-' + $execution.id, cenario: 'leitura_real_amostral' } }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR_FARMA",
          "name": "Hub HML FARMA"
        }
      }
    },
    {
      "id": "wait",
      "name": "Aguardar leitura",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      }
    },
    {
      "id": "result",
      "name": "Consultar resultado e fontes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "url": "=http://hub-api:8000/tarefas/{{ $('Enfileirar Noturno FARMA').first().json.id }}/resultado",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR_FARMA",
          "name": "Hub HML FARMA"
        }
      }
    },
    {
      "id": "terminal",
      "name": "Resultado terminal?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "finished",
              "leftValue": "={{ ['concluida', 'parcial', 'falhou', 'revisao_necessaria'].includes($json.estado) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "evidence",
      "name": "Evidência sem publicação",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        -120
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Iniciar diagnóstico manual": {
      "main": [
        [
          {
            "node": "Enfileirar Noturno FARMA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enfileirar Noturno FARMA": {
      "main": [
        [
          {
            "node": "Aguardar leitura",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aguardar leitura": {
      "main": [
        [
          {
            "node": "Consultar resultado e fontes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar resultado e fontes": {
      "main": [
        [
          {
            "node": "Resultado terminal?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resultado terminal?": {
      "main": [
        [
          {
            "node": "Evidência sem publicação",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Aguardar leitura",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Belem",
    "executionTimeout": 1800,
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none"
  }
}
